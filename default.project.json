{
  "name": "Re-creation of Conquer Europe",
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "DiplomacyManager": { "$path": "src/shared/DiplomacyManager.lua" },
      "NPCCombatSystem": { "$path": "src/shared/NPCCombatSystem.lua" },
      "NPCMovementSystem": { "$path": "src/shared/NPCMovementSystem.lua" },
      "ServerState": { "$path": "src/shared/ServerState.lua" },
      "TileAdjacencyManager": { "$path": "src/shared/TileAdjacencyManager.lua" },
      "TileKeyUtils": { "$path": "src/shared/TileKeyUtils.lua" },
      "TileManager": { "$path": "src/shared/TileManager.lua" },
      "TileOwnershipManager": { "$path": "src/shared/TileOwnershipManager.lua" },
      "UnitManager": { "$path": "src/shared/UnitManager.lua" },
      "Auto-Fix": { "$path": "src/server/Auto-Fix.server.lua" },
      "ClassicDeathScript": { "$path": "src/server/ClassicDeathScript.server.lua" },
      "CollisionSetup": { "$path": "src/server/CollisionSetup.server.lua" },
      "CountryManager": { "$path": "src/server/CountryManager.server.lua" },
      "Diagnostics": { "$path": "src/server/Diagnostics.server.lua" },
      "DiplomacyServer": { "$path": "src/server/DiplomacyServer.server.lua" },
      "Leaderstats": { "$path": "src/server/Leaderstats.server.lua" },
      "CountryNPCRegistry": { "$path": "src/server/CountryNPCRegistry.lua" },
      "NPCPurchaseHandler": { "$path": "src/server/NPCPurchaseHandler.server.lua" },
      "NPCSpawner": { "$path": "src/server/NPCSpawner.lua" },
      "NPCTargetingHandler": { "$path": "src/server/NPCTargetingHandler.server.lua" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "$path": "src/playerscripts"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "BuyNPCGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "BuyNPCGui": { "$path": "src/client/BuyNPCGui.client.lua" }
      },
      "CountrySelectionScreen": {
        "$className": "ScreenGui",
        "$properties": {
          "Enabled": false
        },
        "$ignoreUnknownInstances": true,
        "CountrySelectionScreen": { "$path": "src/client/CountrySelectionScreen.client.lua" }
      },
      "DiplomacyGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "DiplomacyGui": { "$path": "src/client/DiplomacyGui.client.lua" }
      },
      "NotificationGui": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "NotificationGui": { "$path": "src/client/NotificationGui.client.lua" }
      }
    }
  }
}
